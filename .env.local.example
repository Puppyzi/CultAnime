# CultAnime local development example
#
# Use this on the developer machine. This mode can stream through Jellyfin
# over Tailscale, but it does not try to watch the real server media folder.

MEDIA_WATCHER_ENABLED=false
MEDIA_ROOT=/media/anime
JELLYFIN_MEDIA_ROOT=/media/anime
ANIME_MOVIE_ROOT=/media/anime_movies
JELLYFIN_ANIME_MOVIE_ROOT=/media/anime_movies
LIBRARY_RECONCILE_ENABLED=true
LIBRARY_RECONCILE_INTERVAL_MS=60000
LIBRARY_RECONCILE_ON_READ_INTERVAL_MS=0
# Optional: retry Jellyfin metadata for recent episodes that still have no overview.
# MISSING_EPISODE_METADATA_REFRESH_ENABLED=true
# MISSING_EPISODE_METADATA_REFRESH_INTERVAL_MS=900000
# MISSING_EPISODE_METADATA_REFRESH_LOOKBACK_DAYS=45
# MISSING_EPISODE_METADATA_REFRESH_BATCH_LIMIT=8
LOCAL_MEDIA_PRUNE_ENABLED=false

ADMIN_PASSWORD=change_this_for_local_admin
# Optional: set true only when serving CultAnime over HTTPS and your proxy
# does not send x-forwarded-proto=https.
# ADMIN_COOKIE_SECURE=true
NEXT_PUBLIC_SITE_NAME=CultAnime

JELLYFIN_URL=http://YOUR_TAILSCALE_JELLYFIN_IP:8096
JELLYFIN_API_KEY=replace_with_jellyfin_api_key
# Optional: sign same-origin Jellyfin media proxy URLs. Defaults to JELLYFIN_API_KEY.
# JELLYFIN_PROXY_SECRET=replace_with_long_random_secret
# JELLYFIN_PROXY_TTL_SECONDS=43200

# Optional: enables native anime requests through Seerr/Jellyseerr.
SEERR_URL=http://YOUR_SEERR_IP:5055
SEERR_API_KEY=replace_with_seerr_api_key
SEERR_ANIME_MOVIE_ROOT_FOLDER=/media/anime_movies
# Optional: make anime movie requests use a specific Radarr server/profile.
# SEERR_ANIME_MOVIE_RADARR_SERVER_ID=0
# SEERR_ANIME_MOVIE_PROFILE_ID=9
# Optional: strict anime-only filters for the Request tab.
# Defaults to Japanese animation only.
# SEERR_ANIME_ORIGIN_COUNTRIES=JP
# SEERR_ANIME_LANGUAGES=ja
